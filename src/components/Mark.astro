---
/** The § mark: flat green tile, used as logo mark and favicon motif. */
interface Props {
  class?: string;
}
const { class: className = 'h-10 w-10' } = Astro.props;
---

<svg viewBox="0 0 40 40" class={className} aria-hidden="true">
  <rect width="40" height="40" rx="6" fill="#9dc115"></rect>
  <text
    x="20"
    y="29.5"
    text-anchor="middle"
    font-family="Georgia, 'Times New Roman', serif"
    font-size="28"
    font-weight="700"
    fill="#ffffff">§</text
  >
</svg>
