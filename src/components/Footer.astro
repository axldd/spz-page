---
import Mark from './Mark.astro';
import { NAV, SITE } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="mt-24 bg-ink text-white/75">
  <div class="container-page grid gap-10 py-14 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-3">
        <Mark class="h-9 w-9" />
        <span class="text-lg font-bold text-white">{SITE.name}</span>
      </div>
      <p class="mt-4 text-sm">{SITE.tagline}</p>
    </div>

    <div class="text-sm leading-relaxed">
      <p class="mb-3 text-xs font-semibold tracking-wider text-white uppercase">Kontakt</p>
      <p>{SITE.street}<br />{SITE.city}</p>
      <p class="mt-3">
        Tel. <a class="hover:text-brand" href={SITE.phone.href}>{SITE.phone.label}</a><br />
        Fax {SITE.fax}<br />
        <a class="hover:text-brand" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
    </div>

    <nav class="text-sm" aria-label="Fußzeile">
      <p class="mb-3 text-xs font-semibold tracking-wider text-white uppercase">Seiten</p>
      <ul class="space-y-2">
        {NAV.map((item) => <li><a class="hover:text-brand" href={item.href}>{item.label}</a></li>)}
        <li><a class="hover:text-brand" href="/impressum/">Impressum</a></li>
        <li><a class="hover:text-brand" href="/datenschutz/">Datenschutz</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-white/10">
    <div class="container-page py-5 text-xs text-white/50">© {year} {SITE.longName}</div>
  </div>
</footer>
