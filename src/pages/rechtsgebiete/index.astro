---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContactBox from '../../components/ContactBox.astro';

const seiten = await getCollection('seiten');
const bySlug = (s: string) => seiten.find((e) => e.data.slug === s)!;
const family = bySlug('rechtsgebiete/familienrecht');
const familyTopics = seiten.filter((e) => e.data.parent === 'familienrecht').sort((a, b) => a.data.order - b.data.order);
const focus = [bySlug('rechtsgebiete/asyl-und-auslaenderrecht'), bySlug('rechtsgebiete/sozialrecht')];

// The list from the old "Die Rechtsgebiete" page, verbatim.
const general = [
  'Allg. Zivilrecht',
  'Arbeitsrecht',
  'Grundstücksrecht',
  'Kaufrecht',
  'Miet- und Wohnungseigentumsrecht',
  'Schadensersatzrecht',
  'Straßenverkehrsrecht (Unfallregulierung, Bußgeld- und Strafverfahren)',
  'Versicherungsrecht',
  'Vertragsrecht',
  'Werkvertragsrecht',
];
const href = (s: string) => `/${s}/`;
---

<Base title="Rechtsgebiete">
  <PageHeader title="Die Rechtsgebiete" />

  <div class="container-page mt-12 grid gap-12 md:mt-16 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="space-y-12">
      <section class="rounded border border-line p-6 md:p-8">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 class="text-2xl font-bold tracking-tight">
            <a href={href(family.data.slug)} class="hover:text-brand-dark">Familienrecht</a>
          </h2>
          <span class="rounded bg-brand-tint px-3 py-1 text-sm font-semibold text-brand-darker">{family.data.heading}</span>
        </div>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          {
            familyTopics.map((t) => (
              <a
                href={href(t.data.slug)}
                class="group flex items-center justify-between rounded border border-line px-5 py-3.5 font-semibold transition-colors hover:border-brand hover:bg-brand-tint"
              >
                {t.data.title}
                <span class="text-brand-dark transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="grid gap-4 sm:grid-cols-2">
        {
          focus.map((e) => (
            <a href={href(e.data.slug)} class="group rounded border border-line p-6 transition-colors hover:border-brand hover:bg-brand-tint">
              <h2 class="text-xl font-bold tracking-tight group-hover:text-brand-darker">{e.data.title}</h2>
              <span class="mt-3 block text-sm font-semibold text-brand-dark">Mehr erfahren →</span>
            </a>
          ))
        }
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight">Weitere Rechtsgebiete</h2>
        <ul class="mt-6 grid gap-x-8 sm:grid-cols-2">
          {
            general.map((g) => (
              <li class="flex gap-3 border-b border-line py-3 text-ink-soft">
                <span class="mt-2.5 h-1.5 w-1.5 shrink-0 bg-brand" aria-hidden="true" />
                {g}
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <div class="lg:sticky lg:top-28 lg:self-start">
      <ContactBox />
    </div>
  </div>
</Base>
