---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../data/site';

const rows = [
  { label: 'Telefon', value: SITE.phone.label, href: SITE.phone.href },
  { label: 'Sekretariat von Schumann', value: SITE.phoneSecretary.label, href: SITE.phoneSecretary.href },
  { label: 'Fax', value: SITE.fax },
  { label: 'E-Mail Kanzlei', value: SITE.email, href: `mailto:${SITE.email}` },
];
---

<Base title="Kontakt" description={`${SITE.longName}, ${SITE.street}, ${SITE.city}. Telefon ${SITE.phone.label}.`}>
  <PageHeader title="Kontakt" />

  <div class="container-page mt-12 grid gap-10 md:mt-16 lg:grid-cols-2">
    <section class="rounded border border-line p-6 md:p-8">
      <h2 class="text-xl font-bold">{SITE.longName}</h2>
      <p class="mt-3 text-lg text-ink-soft">{SITE.street}<br />{SITE.city}</p>
      <dl class="mt-8 divide-y divide-line border-y border-line">
        {
          rows.map((r) => (
            <div class="flex flex-wrap justify-between gap-x-6 gap-y-1 py-3.5">
              <dt class="text-ink-mute">{r.label}</dt>
              <dd class="font-semibold">
                {r.href ? <a class="text-brand-dark hover:text-brand-darker" href={r.href}>{r.value}</a> : r.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="rounded bg-paper p-6 md:p-8">
      <h2 class="text-xl font-bold">Anfahrt</h2>
      <p class="mt-3 text-lg leading-relaxed text-ink-soft">
        Unser Büro befindet sich in zentraler Lage auf der Haßlocher Straße, im Gebäude der Rüsselsheimer Volksbank. Kostenlose Parkmöglichkeiten sind vorhanden.
      </p>
      <a
        href={SITE.mapsUrl}
        rel="noopener"
        class="mt-8 inline-flex items-center gap-2 rounded bg-brand-dark px-5 py-3 font-semibold text-white hover:bg-brand-darker"
      >
        In Google Maps öffnen ↗
      </a>
    </section>
  </div>
</Base>
